{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/accelerator/verifier-verdict.v1.json",
  "title": "Accelerator independent verifier verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "institutionId", "programId", "companyId", "artifactRef", "maker", "verifier", "verdict", "checks", "findings", "checkedAt"],
  "properties": {
    "schema": {"const": "frankx.accelerator.verifier-verdict.v1"},
    "id": {"type": "string", "minLength": 3},
    "institutionId": {"type": "string", "minLength": 3},
    "programId": {"type": "string", "minLength": 3},
    "companyId": {"type": "string", "minLength": 3},
    "artifactRef": {"type": "string", "minLength": 3},
    "maker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "provider"],
      "properties": {
        "agentId": {"type": "string", "minLength": 3},
        "provider": {"type": "string", "minLength": 2},
        "model": {"type": ["string", "null"]}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "profileId", "provider"],
      "properties": {
        "agentId": {"type": "string", "minLength": 3},
        "profileId": {"const": "independent-verifier"},
        "provider": {"type": "string", "minLength": 2},
        "model": {"type": ["string", "null"]}
      }
    },
    "verdict": {"enum": ["pass", "conditional", "fail"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "residualRisk": {"type": ["string", "null"]},
    "checkedAt": {"type": "string", "format": "date-time"}
  }
}
