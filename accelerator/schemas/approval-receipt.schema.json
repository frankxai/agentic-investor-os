{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/accelerator/approval-receipt.v1.json",
  "title": "Named human approval receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "institutionId", "programId", "companyId", "gateId", "decision", "scope", "issuedBy", "issuedAt", "expiresAt", "artifactRefs"],
  "properties": {
    "schema": {"const": "frankx.accelerator.approval-receipt.v1"},
    "id": {"type": "string", "minLength": 3},
    "institutionId": {"type": "string", "minLength": 3},
    "programId": {"type": "string", "minLength": 3},
    "companyId": {"type": "string", "minLength": 3},
    "gateId": {"type": "string", "minLength": 3},
    "decision": {"enum": ["approved", "rejected", "hold", "revoked"]},
    "scope": {"type": "string", "minLength": 10},
    "issuedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "role"],
      "properties": {
        "type": {"const": "human"},
        "name": {"type": "string", "minLength": 2},
        "role": {"type": "string", "minLength": 2},
        "identityRef": {"type": ["string", "null"]}
      }
    },
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "artifactRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "signatureRef": {"type": ["string", "null"]}
  }
}
